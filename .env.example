# Create a copy of this file named .env
# then replace anything that prefixed with "example" with your own strings

# Database stuff
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=language_game_db

# Environment stuff
ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_SECRET=

# hostname for live demos - this one is J's, if you want your own, make an ngrok account, and replace with your own
LIVE_DEMO_HOST=declared-bottom-cure.ngrok-free.dev